digraph PRISM {
graph [rankdir=TB, bgcolor="white", pad=0.5, nodesep=0.65, ranksep=0.9, splines=spline, outputorder=edgesfirst, fontname="Arial", fontsize=28, labelloc=t, label="PRISM — Level 1 Data Flow Diagram
8 processes | 6 data stores | 6 user roles"];
node [fontname="Arial", fontsize=16, color="#18202b", penwidth=1.4, margin="0.18,0.12"];
edge [fontname="Arial", fontsize=12, arrowsize=0.8, color="#56616e", fontcolor="#18202b", penwidth=1.05];
E0 [shape=box, style=filled, fillcolor="#f1f5f9", label="Office Head / Dean"];
E1 [shape=box, style=filled, fillcolor="#f1f5f9", label="Budget Office"];
E2 [shape=box, style=filled, fillcolor="#f1f5f9", label="Procurement Office"];
E3 [shape=box, style=filled, fillcolor="#f1f5f9", label="Chancellor"];
E4 [shape=box, style=filled, fillcolor="#f1f5f9", label="Vice Chancellor"];
E5 [shape=box, style=filled, fillcolor="#f1f5f9", label="Cashier"];
P1 [shape=Mrecord, style=filled, fillcolor="#ffffff", label="{1.0|Manage Budget Proposals}"];
P2 [shape=Mrecord, style=filled, fillcolor="#ffffff", label="{2.0|Manage Market Scoping}"];
P3 [shape=Mrecord, style=filled, fillcolor="#ffffff", label="{3.0|Manage Reviews and\nSignatures}"];
P4 [shape=Mrecord, style=filled, fillcolor="#ffffff", label="{4.0|Manage Procurement\nPlans}"];
P5 [shape=Mrecord, style=filled, fillcolor="#ffffff", label="{5.0|Manage Procurement\nDocuments}"];
P6 [shape=Mrecord, style=filled, fillcolor="#ffffff", label="{6.0|Manage Delivery and\nPayment Records}"];
P7 [shape=Mrecord, style=filled, fillcolor="#ffffff", label="{7.0|Monitor Procurement\nProgress}"];
P8 [shape=Mrecord, style=filled, fillcolor="#ffffff", label="{8.0|Generate Reports}"];
D1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD>D1</TD><TD SIDES="TB">Budget Proposal<BR/>Records</TD></TR></TABLE>>];
D2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD>D2</TD><TD SIDES="TB">Market Scoping Records</TD></TR></TABLE>>];
D3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD>D3</TD><TD SIDES="TB">Procurement Records</TD></TR></TABLE>>];
D4 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD>D4</TD><TD SIDES="TB">Review and Signature<BR/>Records</TD></TR></TABLE>>];
D5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD>D5</TD><TD SIDES="TB">Delivery and Payment<BR/>Records</TD></TR></TABLE>>];
D6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD>D6</TD><TD SIDES="TB">Report Archives</TD></TR></TABLE>>];
E0 -> P1 [label="Submit Budget Proposal"];
E0 -> P2 [label="Specify Market Scoping\nCriteria"];
E0 -> P2 [label="Select Price References"];
E0 -> P3 [label="Confirm Document Signature"];
E0 -> P6 [label="Record Item Receipt"];
P3 -> E0 [label="Provide Proposal Review and\nApproval Status"];
P2 -> E0 [label="Present Market Scoping\nResults"];
P3 -> E0 [label="Route Documents for\nSignature"];
P7 -> E0 [label="Provide Procurement Schedule\nand Status"];
P7 -> E0 [label="Present Item Receiving\nSummary"];
E1 -> P3 [label="Submit Proposal Review and\nEndorsement"];
P3 -> E1 [label="Forward Proposals for Review"];
P8 -> E1 [label="Provide Budget Utilization\nReport"];
E2 -> P4 [label="Update Procurement Plan"];
E2 -> P5 [label="Submit Purchase Request\nDetails"];
E2 -> P5 [label="Submit Canvassing and\nPurchase Order Details"];
E2 -> P3 [label="Update Document Routing"];
E2 -> P6 [label="Record Procurement Dates and\nDelivery Updates"];
P4 -> E2 [label="Provide Annual Procurement\nPlan"];
P7 -> E2 [label="Provide Procurement\nDocuments and Routing Status"];
P8 -> E2 [label="Provide Procurement and\nReceiving Reports"];
E3 -> P3 [label="Submit Proposal Approval or\nReturn Decision"];
E3 -> P3 [label="Confirm Document Signature"];
P3 -> E3 [label="Forward Proposals for\nApproval"];
P3 -> E3 [label="Route Documents for\nSignature"];
P8 -> E3 [label="Provide Campus Procurement\nReports"];
E4 -> P3 [label="Submit Signature\nConfirmation and Remarks"];
P3 -> E4 [label="Route Documents for\nSignature"];
P8 -> E4 [label="Provide Division Procurement\nStatus and Performance\nReport"];
E5 -> P6 [label="Submit Payment Confirmation\nand Receipt"];
P6 -> E5 [label="Forward Purchase Orders and\nProcessing Proof for Payment"];
P8 -> E5 [label="Provide Payment History"];
P1 -> D1 [label="Save Budget Proposal"];
D1 -> P1 [label="Retrieve Proposal Details"];
P2 -> D2 [label="Save Market Scoping\nReferences"];
D2 -> P2 [label="Retrieve Market Scoping\nReferences"];
D1 -> P3 [label="Retrieve Submitted Proposals"];
P3 -> D1 [label="Update Proposal Review and\nApproval Status"];
D3 -> P3 [label="Retrieve Documents for\nRouting"];
P3 -> D3 [label="Update Document Signing\nStatus"];
P3 -> D4 [label="Save Review and Signature\nHistory"];
D4 -> P3 [label="Retrieve Review and\nSignature History"];
D1 -> P4 [label="Retrieve Approved\nRequirements"];
P4 -> D3 [label="Save Procurement Plan and\nSchedule"];
D3 -> P4 [label="Retrieve Procurement Plan"];
D3 -> P5 [label="Retrieve Procurement\nRequirements and Documents"];
P5 -> D3 [label="Save Procurement Documents"];
D3 -> P6 [label="Retrieve Signed Purchase\nOrders"];
D5 -> P6 [label="Retrieve Delivery and\nPayment Details"];
P6 -> D5 [label="Save Delivery, Receipt, and\nPayment Records"];
P6 -> D3 [label="Update Purchase Order\nDelivery and Payment Status"];
D1 -> P7 [label="Retrieve Proposal Progress"];
D3 -> P7 [label="Retrieve Procurement\nDocuments and Schedules"];
D4 -> P7 [label="Retrieve Routing and\nSignature Status"];
D5 -> P7 [label="Retrieve Receiving and\nPayment Status"];
D1 -> P8 [label="Retrieve Budget Data"];
D3 -> P8 [label="Retrieve Procurement Data"];
D5 -> P8 [label="Retrieve Delivery and\nPayment Data"];
D6 -> P8 [label="Retrieve Archived Reports"];
P8 -> D6 [label="Preserve Finalized Report\nSnapshots"];
P1 -> P2 [label="Supply Proposal Item\nSpecifications"];
P2 -> P1 [label="Supply Selected Price\nReferences"];
P7 -> P8 [label="Supply Consolidated Progress\nSummary"];
}